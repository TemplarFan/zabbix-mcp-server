# Zabbix MCP Server Configuration Example
# Copy this file to .env and fill in your own values.

# Required: Zabbix server URL (JSON-RPC endpoint)
ZABBIX_URL=http://your-zabbix-server/zabbix/api_jsonrpc.php

# Authentication Method 1: API Token (recommended)
ZABBIX_TOKEN=your_api_token_here

# Authentication Method 2: Username/Password (alternative to token)
# ZABBIX_USER=Admin
# ZABBIX_PASSWORD=zabbix

# Optional: Read-only mode (only GET operations allowed)
# Set to true, 1, or yes to enable read-only mode
READ_ONLY=true

# Transport Configuration
# Transport type: stdio (default) or streamable-http
ZABBIX_MCP_TRANSPORT=stdio

# HTTP Transport Configuration (only used when ZABBIX_MCP_TRANSPORT=streamable-http)
ZABBIX_MCP_HOST=127.0.0.1
ZABBIX_MCP_PORT=8000
ZABBIX_MCP_STATELESS_HTTP=false

# Authentication type for HTTP transport (must be 'no-auth' for streamable-http)
AUTH_TYPE=no-auth

# SSL Configuration
# Set to false, 0, or no to disable SSL verification (not recommended for production)
VERIFY_SSL=true

# Report Production Filter
# Test networks excluded by report tools when production_only=true.
# Comma-separated CIDRs, e.g. 192.168.100.0/24,192.168.101.0/24
# Leave empty to disable test-network exclusion.
ZABBIX_TEST_NETWORKS=
